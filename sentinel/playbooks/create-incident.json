{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "alertTitle": {
      "type": "String"
    },
    "severity": {
      "type": "String"
    },
    "description": {
      "type": "String"
    }
  },
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "schema": {
          "type": "object",
          "properties": {
            "alertTitle": {
              "type": "string"
            },
            "severity": {
              "type": "string"
            },
            "description": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "actions": {
    "Build_Incident_Payload": {
      "type": "Compose",
      "inputs": {
        "title": "@triggerBody()?['alertTitle']",
        "severity": "@triggerBody()?['severity']",
        "description": "@triggerBody()?['description']",
        "status": "New",
        "source": "Parking Smart Detection Engineering"
      }
    }
  },
  "outputs": {}
}