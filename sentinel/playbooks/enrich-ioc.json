{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "ipAddress": {
      "type": "String"
    }
  },
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "Http",
      "inputs": {
        "schema": {
          "type": "object",
          "properties": {
            "ipAddress": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "actions": {
    "Prepare_IOC": {
      "type": "Compose",
      "inputs": {
        "indicatorType": "IPv4",
        "indicator": "@triggerBody()?['ipAddress']"
      }
    }
  },
  "outputs": {}
}