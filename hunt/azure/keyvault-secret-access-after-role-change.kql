// ==========================================================
// Threat Hunt: Key Vault Secret Access After Role Change
//
// Hypothesis:
// An attacker may gain or assign elevated permissions and then
// access Key Vault secrets shortly afterwards to obtain
// credentials, tokens, connection strings, or other sensitive data.
//
// MITRE ATT&CK:
// T1098     - Account Manipulation
// T1555     - Credentials from Password Stores
// T1078.004 - Valid Accounts: Cloud Accounts
//
// Data Sources:
// Microsoft Entra ID AuditLogs
// AzureDiagnostics
// ==========================================================

let PrivilegeChanges =
    AuditLogs
    | where OperationName has_any (
        "Add member to role",
        "Add eligible member to role",
        "Add scoped member to role"
    )
    | extend InitiatedByUser =
        tostring(InitiatedBy.user.userPrincipalName)
    | extend TargetUser =
        tostring(TargetResources[0].userPrincipalName)
    | project
        PrivilegeChangeTime = TimeGenerated,
        InitiatedByUser,
        TargetUser,
        OperationName,
        Result;

let KeyVaultSecretAccess =
    AzureDiagnostics
    | where ResourceType =~ "VAULTS"
    | where OperationName has_any (
        "SecretGet",
        "SecretList",
        "KeyGet",
        "CertificateGet"
    )
    | extend Caller =
        coalesce(
            tostring(identity_claim_upn_s),
            tostring(identity_claim_appid_g),
            tostring(CallerIPAddress)
        )
    | project
        SecretAccessTime = TimeGenerated,
        Caller,
        CallerIPAddress,
        OperationName,
        Resource,
        ResourceId,
        ResultType;

PrivilegeChanges
| join kind=inner KeyVaultSecretAccess
    on $left.TargetUser == $right.Caller
| where SecretAccessTime between (
    PrivilegeChangeTime ..
    PrivilegeChangeTime + 2h
)
| project
    PrivilegeChangeTime,
    SecretAccessTime,
    InitiatedByUser,
    TargetUser,
    CallerIPAddress,
    OperationName,
    Resource,
    ResourceId,
    ResultType
| order by SecretAccessTime desc