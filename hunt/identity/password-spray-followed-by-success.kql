// ==========================================================
// Threat Hunt: Password Spray Followed by Successful Sign-in
//
// Hypothesis:
// An attacker may conduct repeated failed authentication
// attempts against an account and later successfully
// authenticate using compromised credentials.
//
// MITRE ATT&CK:
// T1110.003 - Password Spraying
// T1078     - Valid Accounts
//
// Data Source:
// Microsoft Entra ID SigninLogs
// ==========================================================

let FailedSignins =
    SigninLogs
    | where ResultType != 0
    | summarize
        FailedAttempts = count(),
        FirstFailure = min(TimeGenerated),
        LastFailure = max(TimeGenerated)
        by UserPrincipalName, IPAddress
    | where FailedAttempts >= 5;

let SuccessfulSignins =
    SigninLogs
    | where ResultType == 0
    | project
        SuccessfulSigninTime = TimeGenerated,
        UserPrincipalName,
        IPAddress,
        AppDisplayName,
        Location,
        ConditionalAccessStatus;

FailedSignins
| join kind=inner SuccessfulSignins on UserPrincipalName
| where SuccessfulSigninTime between (LastFailure .. LastFailure + 1h)
| project
    UserPrincipalName,
    FailedAttempts,
    FirstFailure,
    LastFailure,
    SuccessfulSigninTime,
    FailedIPAddress = IPAddress,
    SuccessfulIPAddress = IPAddress1,
    AppDisplayName,
    Location,
    ConditionalAccessStatus
| order by SuccessfulSigninTime desc