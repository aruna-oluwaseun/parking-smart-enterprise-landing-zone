// ==========================================================
// Defender XDR Advanced Hunt:
// Suspicious Logon Followed by Credential Access Behaviour
//
// Hypothesis:
// An attacker who obtains access to an account may authenticate
// to an endpoint and subsequently execute tools or commands
// associated with credential discovery or credential dumping.
//
// MITRE ATT&CK:
// T1078     - Valid Accounts
// T1003     - OS Credential Dumping
// T1555     - Credentials from Password Stores
//
// Data Sources:
// DeviceLogonEvents
// DeviceProcessEvents
// ==========================================================

let CorrelationWindow = 15m;

let SuccessfulLogons =
    DeviceLogonEvents
    | where ActionType == "LogonSuccess"
    | where isnotempty(AccountName)
    | project
        LogonTime = Timestamp,
        DeviceId,
        DeviceName,
        AccountName,
        AccountDomain,
        LogonType,
        RemoteIP;

let CredentialAccessProcesses =
    DeviceProcessEvents
    | where FileName in~ (
        "mimikatz.exe",
        "procdump.exe",
        "cmdkey.exe",
        "vaultcmd.exe",
        "rundll32.exe"
    )
    or ProcessCommandLine has_any (
        "sekurlsa",
        "lsass",
        "comsvcs.dll",
        "MiniDump",
        "cmdkey /list",
        "vaultcmd /list"
    )
    | project
        ProcessTime = Timestamp,
        DeviceId,
        DeviceName,
        AccountName,
        FileName,
        ProcessCommandLine,
        InitiatingProcessFileName,
        SHA1,
        SHA256;

SuccessfulLogons
| join kind=inner CredentialAccessProcesses
    on DeviceId, AccountName
| where ProcessTime between (
    LogonTime .. LogonTime + CorrelationWindow
)
| project
    LogonTime,
    ProcessTime,
    DeviceName,
    AccountDomain,
    AccountName,
    LogonType,
    RemoteIP,
    FileName,
    ProcessCommandLine,
    InitiatingProcessFileName,
    SHA1,
    SHA256
| order by ProcessTime desc