// ==========================================================
// Defender XDR Custom Detection Candidate:
// Suspicious LOLBin Network Activity
//
// Purpose:
// Identify trusted Windows binaries being executed with
// command-line characteristics commonly associated with
// proxy execution or remote content retrieval.
//
// MITRE ATT&CK:
// T1218 - System Binary Proxy Execution
// T1105 - Ingress Tool Transfer
//
// Data Source:
// DeviceProcessEvents
//
// Severity: High
// ==========================================================

DeviceProcessEvents
| where FileName in~ (
    "certutil.exe",
    "bitsadmin.exe",
    "mshta.exe",
    "regsvr32.exe"
)
| where ProcessCommandLine has_any (
    "http://",
    "https://",
    "urlcache",
    "transfer",
    "javascript:",
    "vbscript:",
    "scrobj.dll"
)
| project
    Timestamp,
    DeviceId,
    DeviceName,
    AccountName,
    FileName,
    ProcessCommandLine,
    InitiatingProcessFileName,
    InitiatingProcessCommandLine,
    ProcessId,
    SHA1,
    SHA256,
    ReportId