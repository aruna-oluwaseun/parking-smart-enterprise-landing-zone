// ==========================================================
// Defender XDR Custom Detection Candidate:
// Suspicious PowerShell Download Activity
//
// Purpose:
// Detect suspicious PowerShell execution that performs or
// prepares network-based payload retrieval.
//
// MITRE ATT&CK:
// T1059.001 - PowerShell
// T1105     - Ingress Tool Transfer
//
// Data Source:
// DeviceProcessEvents
//
// Severity: High
// ==========================================================

DeviceProcessEvents
| where FileName in~ ("powershell.exe", "pwsh.exe")
| where ProcessCommandLine has_any (
    "Invoke-WebRequest",
    "DownloadString",
    "DownloadFile",
    "Start-BitsTransfer",
    "Net.WebClient",
    "WebClient",
    "FromBase64String",
    "-EncodedCommand",
    "-enc "
)
| where ProcessCommandLine has_any (
    "http://",
    "https://",
    "DownloadString",
    "DownloadFile",
    "Invoke-WebRequest",
    "Start-BitsTransfer"
)
| project
    Timestamp,
    DeviceId,
    DeviceName,
    AccountName,
    FileName,
    ProcessCommandLine,
    InitiatingProcessFileName,
    InitiatingProcessCommandLine,
    ProcessId,
    SHA1,
    SHA256,
    ReportId