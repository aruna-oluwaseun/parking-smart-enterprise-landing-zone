// ==========================================================
// Detection: Excessive Secret Access
// Description: Detects a high volume of Azure Key Vault secret
//              retrieval activity that may indicate credential theft.
// MITRE ATT&CK: T1555.006 - Cloud Secrets Management Stores
// Tactic: Credential Access
// Severity: High
// Data Source: AzureDiagnostics
// False Positives: Deployment pipelines, application startup,
//                  approved secret rotation or bulk maintenance
// Response Playbook: enrich-ioc / create-incident
// Author: Aruna Oluwaseun
// Last Updated: August 2026
// ==========================================================

AzureDiagnostics
| where OperationName contains "SecretGet"
| summarize SecretRequests = count()
    by CallerIPAddress, bin(TimeGenerated, 5m)
| where SecretRequests > 20
| order by SecretRequests desc