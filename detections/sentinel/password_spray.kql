// ==========================================================
// Detection: Password Spray
// Description: Detects a single source IP attempting failed
//              authentication against multiple Entra ID
//              accounts within a short period.
// MITRE ATT&CK: T1110.003 - Password Spraying
// Tactic: Credential Access
// Severity: High
// Data Source: SigninLogs
// False Positives: Shared corporate proxies, VPN gateways,
//                  misconfigured applications or authorised
//                  security testing.
// Response Playbook: enrich-ioc / notify-teams
// Author: Aruna Oluwaseun
// Last Updated: August 2026
// ==========================================================

let DetectionWindow = 15m;
let FailedAttemptThreshold = 20;
let TargetAccountThreshold = 5;

SigninLogs
| where ResultType != 0
| where isnotempty(IPAddress)
| where isnotempty(UserPrincipalName)
| summarize
    FailedAttempts = count(),
    TargetAccounts = dcount(UserPrincipalName),
    Accounts = make_set(UserPrincipalName, 20),
    Applications = make_set(AppDisplayName, 10),
    Locations = make_set(Location, 10),
    FirstSeen = min(TimeGenerated),
    LastSeen = max(TimeGenerated)
    by IPAddress, bin(TimeGenerated, DetectionWindow)
| where FailedAttempts >= FailedAttemptThreshold
| where TargetAccounts >= TargetAccountThreshold
| extend
    AttemptsPerAccount =
        round(todouble(FailedAttempts) / todouble(TargetAccounts), 2)
| project
    TimeGenerated,
    FirstSeen,
    LastSeen,
    IPAddress,
    FailedAttempts,
    TargetAccounts,
    AttemptsPerAccount,
    Accounts,
    Applications,
    Locations
| order by FailedAttempts desc