// ==========================================================
// Detection: Password Spray
// Description: Detects one source attempting authentication
//              against multiple accounts within a short period.
// MITRE ATT&CK: T1110.003 - Password Spraying
// Tactic: Credential Access
// Severity: High
// Data Source: SigninLogs
// False Positives: Shared corporate proxies, badly configured
//                  applications or password synchronization issues
// Response Playbook: enrich-ioc / notify-teams
// Author: Aruna Oluwaseun
// Last Updated: August 2026
// ==========================================================

SigninLogs
| where ResultType != 0
| summarize
    FailedAttempts = count(),
    TargetAccounts = dcount(UserPrincipalName),
    Accounts = make_set(UserPrincipalName, 20)
    by IPAddress, bin(TimeGenerated, 15m)
| where FailedAttempts >= 20
| where TargetAccounts >= 5
| project
    TimeGenerated,
    IPAddress,
    FailedAttempts,
    TargetAccounts,
    Accounts
| order by FailedAttempts desc